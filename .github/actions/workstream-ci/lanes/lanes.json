  "lanes": {
    "0": {
      "checks": "secret scan",
      "merge": "automatic on green",
      "name": "Record",
      "review": "none"
    },
    "1": {
      "checks": "affected lanes, new-finding scan",
      "merge": "automatic on green",
      "name": "Standard",
      "review": "none"
    },
    "2": {
      "checks": "affected lanes, new-finding scan",
      "merge": "automatic on green and a clear review",
      "name": "Code",
      "review": "standard, blocking"
    },
    "3": {
      "checks": "every lane at full stage",
      "merge": "owner",
      "name": "Stateful",
      "review": "deep, blocking"
    },
    "4": {
      "checks": "every lane at full stage",
      "merge": "owner",
      "name": "Platform",
      "review": "deep, blocking"
    },
    "E": {
      "checks": "secret scan now; the underlying lane's checks after merge",
      "merge": "owner",
      "name": "Emergency",
      "review": "none before merge"
    }
